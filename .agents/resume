#!/usr/bin/env bash
# Orb resume for yanki.
#
# Runs after activation and whenever a paused orb wakes. It stays read-only and
# always exits 0: a missing toolchain or module cache is recoverable, and
# blocking the orb start would hide the real state.

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

problems=()
prepared=()

check_command() {
	if command -v "$1" > /dev/null 2>&1 || [[ -x "$2" ]]; then
		prepared+=("$1")
	else
		problems+=("$1 is not installed")
	fi
}

check_path() {
	if [[ -e "$1" ]]; then
		prepared+=("$2")
	else
		problems+=("$2 is missing at $1")
	fi
}

check_command go /usr/local/go/bin/go
check_path go.sum 'Go module checksums'

if ((${#prepared[@]} > 0)); then
	printf 'Ready: %s\n' "${prepared[*]}"
fi

if ((${#problems[@]} > 0)); then
	printf 'Not ready: %s\n' "${problems[*]}"
fi

exit 0
