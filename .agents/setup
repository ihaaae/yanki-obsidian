#!/usr/bin/env bash
# Orb setup for yanki.
#
# Runs once before a fresh orb starts work: installs the Go toolchain when it is
# missing and primes the module cache. Every step checks for existing work
# first, so repeat runs (stale snapshots, repository updates) are fast.

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

started=$SECONDS

run_step() {
	local name="$1"
	shift
	local step_started=$SECONDS
	printf '\n=== %s ===\n' "$name"
	"$@"
	printf '=== %s took %ss ===\n' "$name" "$((SECONDS - step_started))"
}

go_binary() {
	if [[ -x /usr/local/go/bin/go ]]; then
		printf '%s\n' /usr/local/go/bin/go
	elif command -v go > /dev/null 2>&1; then
		command -v go
	fi
}

install_go() {
	local existing
	existing="$(go_binary)"

	if [[ -n "$existing" ]]; then
		printf 'Go is already installed: %s\n' "$("$existing" version)"
		return
	fi

	# Install the current stable release; it satisfies go.mod's minimum.
	local version
	version="$(curl -sSL --max-time 60 'https://go.dev/VERSION?m=text' | head -1)"
	if [[ -z "$version" ]]; then
		printf 'Could not determine the latest Go version.\n' >&2
		return 1
	fi

	local archive="${version}.linux-amd64.tar.gz"
	printf 'Installing %s\n' "$version"
	curl -sSL --max-time 300 -o "/tmp/${archive}" "https://go.dev/dl/${archive}"

	local prefix=/usr/local
	local privileged=()
	if ((EUID != 0)); then
		privileged=(sudo)
	fi

	"${privileged[@]}" rm -rf "${prefix}/go"
	"${privileged[@]}" tar -C "$prefix" -xzf "/tmp/${archive}"
	rm -f "/tmp/${archive}"

	printf 'Installed %s\n' "$("${prefix}/go/bin/go" version)"
}

# Agent shells do not inherit /usr/local/go/bin automatically.
ensure_go_on_path() {
	if ! grep -q '/usr/local/go/bin' "$HOME/.bashrc" 2> /dev/null; then
		printf '\nexport PATH="$PATH:/usr/local/go/bin"\n' >> "$HOME/.bashrc"
	fi
}

download_modules() {
	export PATH="${PATH}:/usr/local/go/bin"
	go mod download
}

run_step 'Go toolchain' install_go
run_step 'Go on PATH' ensure_go_on_path
run_step 'Go modules' download_modules

printf '\nSetup finished in %ss\n' "$((SECONDS - started))"
